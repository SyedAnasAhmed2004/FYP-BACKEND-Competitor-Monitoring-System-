# Django Settings
# Required. Use a unique random value of 50+ characters (the app refuses to start without it when DEBUG=False).
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DEBUG=False  # only set True on your own machine
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - PostgreSQL
POSTGRES_DB=competitor_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=competitor_data
MILVUS_DIMENSION=768

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS Settings (React Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
DJANGO_LOG_LEVEL=INFO

# Optional: Sentry for error tracking
# SENTRY_DSN=your-sentry-dsn-here
# Firecrawl API Configuration
FIRECRAWL_API_KEY=Firecrawl API 

# OpenRouter API Configuration
OPENROUTER_API_KEY=OpenRouter API

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Security (set to False in production)
DEBUG=False

# Email Alerts (SendGrid)
# Sign up at sendgrid.com → Settings → API Keys → Create API Key
# Verify a sender email at sendgrid.com → Settings → Sender Authentication
SENDGRID_API_KEY=your-sendgrid-api-key-here
DEFAULT_FROM_EMAIL=TrackRival <your-verified-sender@gmail.com>

# Security
# Auth tokens expire after this many days
TOKEN_TTL_DAYS=14
# Set True once served over HTTPS (enables SSL redirect, secure cookies, HSTS)
USE_HTTPS=False
# Login/register rate limits per client IP
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour

# Django admin site protection
# Only these IPs/CIDR ranges can open the admin (everyone else gets a 404). Default: this machine only.
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Path of the admin site. Use something non-obvious in production, e.g. ops-7f3k2/
ADMIN_URL=admin/
# Number of reverse proxies (e.g. Nginx) in front of Django. 0 = none.
# If 1, the proxy MUST overwrite X-Forwarded-For with the real client IP.
ADMIN_TRUSTED_PROXY_COUNT=0

# Apify (LinkedIn / Facebook / Instagram scrapers)
APIFY_API_TOKEN=your-apify-token-here
